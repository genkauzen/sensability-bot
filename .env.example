# Telegram
BOT_TOKEN=
# true/false — SOCKS5 для Telegram
TG_PROXY_USE=false
TG_PROXY_URL=

GROUP_ID=
TOPIC_ID_LOGS=
TOPIC_ID_UPDAYWORK=
TOPIC_ID_LIVE=
TOPIC_ID_TERMINAL=
TOPIC_ID_ACCOUNTVERIFY=
TOPIC_ID_TOTALRESULT=

# Логи
FULL_LOGS=false

# Ежедневный отчёт (локальное время контейнера), пример: 00:00
UPDAYWORK_UPLOADTIME=00:00

# Terminal
TERMINAL_PUBLIC_ACCESS=false
TERMINAL_USERID_ACCESS=

# AccountVerify
ACCOUNTVERIFY_PUBLIC_ACCESS=false
ACCOUNTVERIFY_USERID_ACCESS=

# Timeweb Cloud API
TWC_PROXY_USE=false
TWC_PROXY_URL=

# Имя создаваемых ВМ
TWC_VM_NAME=sensability-vm
# Зона: msk-1, spb-3 и т.д.
TWC_VM_REGION=spb-3
# Тариф и ОС — возьмите актуальные ID из API /presets/servers и списка ОС
TWC_PRESET_ID=122
TWC_OS_ID=65
TWC_BANDWIDTH=200

TWC_ATMOMENT_ACC=3
TWC_MINIMUM_RUBLES=50
# Минуты держать ВМ включённой после попадания IP в ПНА
TWC_VM_ALIVETIME=5

# Синхронизация аккаунтов (минуты)
DB_SYNC_TIME=5

# Каталог на хосте с docker-compose.yml (для /drop /rebuild /restart из контейнера)
SENSABILITY_COMPOSE_DIR=/
