# Sensability
# Telegram
# токен бота
BOT_TOKEN=
# true/false Включение socks5proxy для телеграм если надо
TG_PROXY_USE=
# URL Socks5 прокси(если PROXY_USE=true)
# пример=socks5://user:pass@host:port
TG_PROXY_URL=
# Заполнение значений для телеграм группы
# Айди группы пример:-1003958590443
GROUP_ID=
# Топик для общих логов
TOPIC_ID_LOGS=
# Топик для  итогов работы за день
TOPIC_ID_UPDAYWORK=
# Топик для вывода текущих процессов
TOPIC_ID_LIVE=
# Топик  для терминала(ввод команд/общение с ботом в реальном времени)
TOPIC_ID_TERMINAL=
# Топик для сохранения api от аккаунтов timewebcloud
TOPIC_ID_ACCOUNTVERIFY=
# Топик для вывода итогового результата(серверов с бс)
TOPIC_ID_TOTALRESULT=

# Логи
# Вывод всех логов бота(попытки загрузки и тд)
# true - полностью выводить false - только основные(в том числе и логи обращения timewebcloud api)
FULL_LOGS=

# Время загрузки итоговых результатов работы за день
# пример: 00:00
UPDAYWORK_UPLOADTIME=

# Terminal
# Дать доступ всем пользователям к терминалу(true/false)
TERMINAL_PUBLIC_ACCESS=
# Доступ у определенных пользователей(если TERMINAL_PUBLIC_ACCESS=false)
TERMINAL_USERID_ACCESS=

# AccountVerify
# Дать доступ всем пользователям к каналу(true/false)
ACCOUNTVERIFY_PUBLIC_ACCESS=
# Доступ у определенных пользователей(если ACCOUNTVERIFY_PUBLIC_ACCESS=false)
ACCOUNTVERIFY_USERID_ACCESS=

# Настройки TIMEWEBCLOUD части
# true/false Включение socks5proxy для запросов к twc api если надо
TWC_PROXY_USE=
# URL Socks5 прокси(если PROXY_USE=true)
# пример=socks5://user:pass@host:port
TWC_PROXY_URL=
# название вм (по умолчанию "sensability-vm")
TWC_VM_NAME=
# Регион - Москва = msk-1 / Санкт-Петербург = spb-3
# пример: msk-1 по умолчанию spb-3
TWC_VM_REGION=
# Сколько бот может одновременно задействовать аккаунтов для перебора
TWC_ATMOMENT_ACC=
# Минимальный баланс для перебора (рубли)
TWC_MINIMUM_RUBLES=
# Время жизни вм(в минутах) с белым айпи(после истечения таймера выключит ее для низкого потребления баланса)
# пример:5 по умолчанию:5
TWC_VM_ALIVETIME=

# Настройки БД
# Глобальная синхронизация информаци всех аккаунтов через twc api
# каждые n минут, пример: 1
DB_SYNC_TIME=
